{
  "name": "neural-icons-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "build:vercel": "npm exec -- nx run showcase:build && node tools/build-vercel-output.mjs",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx format --write",
    "format:check": "nx format --check",
    "generate:icons": "node tools/icons.mjs",
    "watch:icons": "node tools/watch-icons.mjs",
    "generate:filled": "node tools/add-filled.mjs && node tools/icons.mjs",
    "generate:variants": "node tools/add-filled.mjs && node tools/icons.mjs",
    "check:generated": "node tools/icons.mjs --check && node tools/generate-catalog-review.mjs --check && node tools/generate-ni06-review.mjs --check",
    "validate:icons": "node tools/validate-icons.mjs",
    "check": "npm run check:generated && npm run validate:icons && nx run-many -t lint,test,build && nx run angular:verify-package",
    "verify:release": "npm run check && nx run react:typecheck && nx run vue:typecheck && nx run react:verify-package && nx run vue:verify-package && node tools/verify-release-candidate.mjs && node tools/verify-clean-angular-consumer.mjs && nx run showcase-e2e:e2e",
    "build:cloudflare": "node tools/build-cloudflare-output.mjs"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-server": "22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/ssr": "22.1.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.6",
    "@angular-devkit/schematics": "22.1.6",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@angular/language-service": "22.1.6",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.2.0",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/playwright": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "22.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~22.1.0",
    "nx": "23.2.0",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.0",
    "vitest": "~4.1.0",
    "vue": "3.5.43"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
