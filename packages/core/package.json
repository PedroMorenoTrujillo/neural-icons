{
  "name": "@neural-icons/core",
  "version": "1.1.0",
  "type": "module",
  "description": "Framework-agnostic icon definitions for the Neural design system.",
  "repository": { "type": "git", "url": "git+https://github.com/PedroMorenoTrujillo/neural-icons.git", "directory": "packages/core" },
  "homepage": "https://icons.neuralui.org/",
  "bugs": "https://github.com/PedroMorenoTrujillo/neural-icons/issues",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./svg/*.svg": "./svg/*.svg",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./catalog": {
      "types": "./src/icons/index.d.ts",
      "import": "./src/icons/index.js",
      "default": "./src/icons/index.js"
    },
    "./icons/index": null,
    "./icons/*": {
      "types": "./src/icons/*.d.ts",
      "import": "./src/icons/*.js",
      "default": "./src/icons/*.js"
    }
  },
  "files": [
    "src",
    "svg",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "license": "MIT"
}
