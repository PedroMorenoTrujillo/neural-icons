{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/src",
  "prefix": "neural",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:angular", "type:library", "platform:angular"],
  "targets": {
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "cache": false,
      "options": {
        "command": "node tools/check-packages.mjs"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/ng-package.json",
        "tsConfig": "packages/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "hydration-build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/fixtures/angular-hydration"],
      "options": {
        "outputPath": "dist/fixtures/angular-hydration",
        "browser": "packages/angular/fixtures/hydration/main.ts",
        "index": "packages/angular/fixtures/hydration/index.html",
        "tsConfig": "packages/angular/fixtures/hydration/tsconfig.json",
        "server": "packages/angular/fixtures/hydration/main.server.ts",
        "ssr": { "entry": "packages/angular/fixtures/hydration/server.ts" },
        "prerender": false,
        "outputMode": "server"
      }
    },
    "hydration-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["hydration-build"],
      "cache": false,
      "options": { "command": "node tools/test-angular-hydration.mjs" }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
